{
  "name": "memory-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "setup-assets": "node scripts/setup-assets.mjs",
    "postinstall": "node scripts/setup-assets.mjs --wasm-only",
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "deploy": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "@fontsource/gochi-hand": "5.3.0",
    "@mediapipe/tasks-vision": "1.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
